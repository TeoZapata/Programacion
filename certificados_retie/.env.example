## ================================================
## .env.example — Copiar como .env y configurar
## ================================================

# Entorno: development | production | testing
FLASK_ENV=development
FLASK_DEBUG=false

# Clave secreta para sesiones (CAMBIAR en producción)
SECRET_KEY=retie-clave-secreta-2024-cambiar-obligatorio

# Servidor
HOST=0.0.0.0
PORT=5000

## Base de datos ─────────────────────────────────
# SQLite (desarrollo local - no requiere instalación)
DATABASE_URL=sqlite:///retie_dev.db

# PostgreSQL (producción)
# DATABASE_URL=postgresql://retie_user:retie_password@localhost:5432/retie_db

## OCR ────────────────────────────────────────────
# Linux/Mac
TESSERACT_CMD=/usr/bin/tesseract

# Windows
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
