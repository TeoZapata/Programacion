-- Creación de la tabla de Clientes
CREATE TABLE Clientes (
    cliente_id INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    empresa VARCHAR(100),
    telefono VARCHAR(20),
    email VARCHAR(100),
    direccion VARCHAR(200),
    fecha_registro DATE NOT NULL DEFAULT CURRENT_DATE,
    activo BOOLEAN NOT NULL DEFAULT TRUE
);

-- Creación de la tabla de Proyectos
CREATE TABLE Proyectos (
    proyecto_id INT PRIMARY KEY AUTO_INCREMENT,
    cliente_id INT NOT NULL,
    nombre_proyecto VARCHAR(100) NOT NULL,
    descripcion TEXT,
    fecha_inicio DATE,
    fecha_fin_estimada DATE,
    fecha_fin_real DATE,
    estado ENUM('Pendiente', 'En Progreso', 'Finalizado', 'Cancelado') DEFAULT 'Pendiente',
    presupuesto DECIMAL(12, 2),
    FOREIGN KEY (cliente_id) REFERENCES Clientes(cliente_id)
);

-- Creación de la tabla de Categorías de Productos
CREATE TABLE Categorias (
    categoria_id INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(50) NOT NULL,
    descripcion TEXT
);

-- Creación de la tabla de Productos
CREATE TABLE Productos (
    producto_id INT PRIMARY KEY AUTO_INCREMENT,
    categoria_id INT,
    codigo VARCHAR(20) UNIQUE NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    descripcion TEXT,
    unidad_medida VARCHAR(20) NOT NULL,
    precio_unitario DECIMAL(10, 2) NOT NULL,
    stock_actual INT NOT NULL DEFAULT 0,
    stock_minimo INT NOT NULL DEFAULT 5,
    fecha_alta DATE NOT NULL DEFAULT CURRENT_DATE,
    activo BOOLEAN NOT NULL DEFAULT TRUE,
    FOREIGN KEY (categoria_id) REFERENCES Categorias(categoria_id)
);

-- Creación de la tabla de Tipos de Movimientos
CREATE TABLE TiposMovimiento (
    tipo_movimiento_id INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(50) NOT NULL,
    descripcion TEXT,
    afecta_stock INT NOT NULL -- 1: incrementa, -1: decrementa, 0: no afecta
);

-- Inserción de los tipos de movimiento básicos
INSERT INTO TiposMovimiento (nombre, descripcion, afecta_stock) VALUES
('Entrada', 'Entrada de productos al almacén', 1),
('Salida', 'Salida de productos del almacén a un proyecto', -1),
('Devolución', 'Devolución de productos de un proyecto al almacén', 1);

-- Creación de la tabla de Movimientos de Almacén
CREATE TABLE MovimientosAlmacen (
    movimiento_id INT PRIMARY KEY AUTO_INCREMENT,
    tipo_movimiento_id INT NOT NULL,
    proyecto_id INT,
    fecha_movimiento DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    referencia VARCHAR(50),
    observaciones TEXT,
    usuario_id INT,
    FOREIGN KEY (tipo_movimiento_id) REFERENCES TiposMovimiento(tipo_movimiento_id),
    FOREIGN KEY (proyecto_id) REFERENCES Proyectos(proyecto_id)
);

-- Creación de la tabla de Detalle de Movimientos
CREATE TABLE DetalleMovimientos (
    detalle_id INT PRIMARY KEY AUTO_INCREMENT,
    movimiento_id INT NOT NULL,
    producto_id INT NOT NULL,
    cantidad DECIMAL(10, 2) NOT NULL,
    precio_unitario DECIMAL(10, 2) NOT NULL,
    subtotal DECIMAL(12, 2) GENERATED ALWAYS AS (cantidad * precio_unitario) STORED,
    FOREIGN KEY (movimiento_id) REFERENCES MovimientosAlmacen(movimiento_id),
    FOREIGN KEY (producto_id) REFERENCES Productos(producto_id)
);

-- Creación de la tabla de relación entre Proyectos y Productos asignados
CREATE TABLE ProyectoProductos (
    proyecto_producto_id INT PRIMARY KEY AUTO_INCREMENT,
    proyecto_id INT NOT NULL,
    producto_id INT NOT NULL,
    cantidad_asignada DECIMAL(10, 2) NOT NULL DEFAULT 0,
    cantidad_utilizada DECIMAL(10, 2) NOT NULL DEFAULT 0,
    cantidad_devuelta DECIMAL(10, 2) NOT NULL DEFAULT 0,
    FOREIGN KEY (proyecto_id) REFERENCES Proyectos(proyecto_id),
    FOREIGN KEY (producto_id) REFERENCES Productos(producto_id)
);

-- Creación de un trigger para actualizar el stock al registrar un movimiento
DELIMITER //
CREATE TRIGGER after_detalle_movimiento_insert
AFTER INSERT ON DetalleMovimientos
FOR EACH ROW
BEGIN
    DECLARE v_afecta_stock INT;
    
    -- Obtener el efecto sobre el stock del tipo de movimiento
    SELECT tm.afecta_stock INTO v_afecta_stock
    FROM MovimientosAlmacen ma
    JOIN TiposMovimiento tm ON ma.tipo_movimiento_id = tm.tipo_movimiento_id
    WHERE ma.movimiento_id = NEW.movimiento_id;
    
    -- Actualizar el stock del producto
    UPDATE Productos
    SET stock_actual = stock_actual + (NEW.cantidad * v_afecta_stock)
    WHERE producto_id = NEW.producto_id;
    
    -- Si es un movimiento relacionado con un proyecto, actualizar la tabla ProyectoProductos
    IF (SELECT proyecto_id FROM MovimientosAlmacen WHERE movimiento_id = NEW.movimiento_id) IS NOT NULL THEN
        DECLARE v_proyecto_id INT;
        DECLARE v_tipo_movimiento_id INT;
        
        SELECT proyecto_id, tipo_movimiento_id INTO v_proyecto_id, v_tipo_movimiento_id
        FROM MovimientosAlmacen
        WHERE movimiento_id = NEW.movimiento_id;
        
        -- Asegurarse de que existe la relación proyecto-producto
        INSERT INTO ProyectoProductos (proyecto_id, producto_id, cantidad_asignada)
        SELECT v_proyecto_id, NEW.producto_id, 0
        FROM dual
        WHERE NOT EXISTS (
            SELECT 1 FROM ProyectoProductos 
            WHERE proyecto_id = v_proyecto_id AND producto_id = NEW.producto_id
        );
        
        -- Actualizar según el tipo de movimiento
        IF v_tipo_movimiento_id = 2 THEN -- Salida
            UPDATE ProyectoProductos
            SET cantidad_asignada = cantidad_asignada + NEW.cantidad,
                cantidad_utilizada = cantidad_utilizada + NEW.cantidad
            WHERE proyecto_id = v_proyecto_id AND producto_id = NEW.producto_id;
        ELSEIF v_tipo_movimiento_id = 3 THEN -- Devolución
            UPDATE ProyectoProductos
            SET cantidad_devuelta = cantidad_devuelta + NEW.cantidad,
                cantidad_utilizada = cantidad_utilizada - NEW.cantidad
            WHERE proyecto_id = v_proyecto_id AND producto_id = NEW.producto_id;
        END IF;
    END IF;
END //
DELIMITER ;

-- Vista para visualizar el inventario actual
CREATE VIEW VistaInventarioActual AS
SELECT 
    p.producto_id,
    p.codigo,
    p.nombre,
    c.nombre AS categoria,
    p.stock_actual,
    p.unidad_medida,
    p.precio_unitario,
    (p.stock_actual * p.precio_unitario) AS valor_total,
    CASE WHEN p.stock_actual <= p.stock_minimo THEN 'Reordenar' ELSE 'OK' END AS estado_stock
FROM 
    Productos p
LEFT JOIN 
    Categorias c ON p.categoria_id = c.categoria_id
WHERE 
    p.activo = TRUE
ORDER BY 
    c.nombre, p.nombre;

-- Vista para visualizar los productos por proyecto
CREATE VIEW VistaProductosPorProyecto AS
SELECT 
    pr.proyecto_id,
    pr.nombre_proyecto,
    c.nombre AS cliente,
    p.producto_id,
    p.codigo,
    p.nombre AS producto,
    pp.cantidad_asignada,
    pp.cantidad_utilizada,
    pp.cantidad_devuelta,
    (pp.cantidad_asignada - pp.cantidad_devuelta) AS cantidad_neta,
    p.precio_unitario,
    ((pp.cantidad_asignada - pp.cantidad_devuelta) * p.precio_unitario) AS costo_total
FROM 
    ProyectoProductos pp
JOIN 
    Proyectos pr ON pp.proyecto_id = pr.proyecto_id
JOIN 
    Productos p ON pp.producto_id = p.producto_id
JOIN 
    Clientes c ON pr.cliente_id = c.cliente_id
WHERE 
    pp.cantidad_asignada > 0
ORDER BY 
    pr.nombre_proyecto, p.nombre;

-- Vista para visualizar el historial de movimientos
CREATE VIEW VistaHistorialMovimientos AS
SELECT 
    ma.movimiento_id,
    tm.nombre AS tipo_movimiento,
    ma.fecha_movimiento,
    ma.referencia,
    pr.nombre_proyecto,
    c.nombre AS cliente,
    p.codigo,
    p.nombre AS producto,
    dm.cantidad,
    p.unidad_medida,
    dm.precio_unitario,
    dm.subtotal,
    ma.observaciones
FROM 
    MovimientosAlmacen ma
JOIN 
    TiposMovimiento tm ON ma.tipo_movimiento_id = tm.tipo_movimiento_id
LEFT JOIN 
    Proyectos pr ON ma.proyecto_id = pr.proyecto_id
LEFT JOIN 
    Clientes c ON pr.cliente_id = c.cliente_id
JOIN 
    DetalleMovimientos dm ON ma.movimiento_id = dm.movimiento_id
JOIN 
    Productos p ON dm.producto_id = p.producto_id
ORDER BY 
    ma.fecha_movimiento DESC;